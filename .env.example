# ── Magical by Reign — environment ─────────────────────────────
# Copy to `.env` and fill in. The skeleton runs with just DATABASE_URL.

# Local development uses SQLite (zero setup).
# For production, switch prisma/schema.prisma provider to "postgresql"
# and point this at your Postgres instance, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/magicalbyreign"
DATABASE_URL="file:./dev.db"

# Public base URL — used to build shareable experience links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Integrations (wired in later phases) ───────────────────────
# AI layer (powers the design engine's generative customization).
# The skeleton falls back to the deterministic engine when unset.
ANTHROPIC_API_KEY=""

# Payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Media / object storage (S3-compatible).
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI video integration.
VIDEO_API_KEY=""
