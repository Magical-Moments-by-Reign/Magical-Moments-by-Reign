# ── Magical by Reign — environment ─────────────────────────────
# Copy to `.env` and fill in. The skeleton runs with just DATABASE_URL.

# Postgres connection string. A free Neon (neon.tech) or Supabase
# database works for both local dev and production. Use the POOLED
# connection string for serverless (Netlify). Example:
#   DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/magicalbyreign?sslmode=require"
DATABASE_URL="postgresql://user:pass@host:5432/magicalbyreign?sslmode=require"

# Public base URL — used to build shareable experience links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Integrations (wired in later phases) ───────────────────────
# AI layer (powers the design engine's generative customization).
# The skeleton falls back to the deterministic engine when unset.
ANTHROPIC_API_KEY=""

# Payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Media / object storage (S3-compatible).
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ── Customer media uploads (Supabase Storage) ──────────────────
# Powers the photo & video uploader (drag-and-drop on the build page).
# Uploads go DIRECTLY from the browser to Supabase Storage via a
# short-lived signed URL, so large videos aren't blocked by serverless
# request-size limits. When unset, the uploader still validates files
# against the plan and shows upgrade prompts, but can't store them.
#   1. Supabase → Storage → create a PUBLIC bucket named "media".
#   2. Fill these in (service role key is server-only — never exposed):
SUPABASE_URL=""                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""    # Supabase → Settings → API → service_role
SUPABASE_STORAGE_BUCKET="media"

# AI video integration.
VIDEO_API_KEY=""

# ── Square payments (cart + checkout) ──────────────────────────
# sandbox | production. Card fields + payments only activate when the
# App ID + Location ID (public) and Access Token (secret) are set.
SQUARE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# ── Transactional email (Resend) ───────────────────────────────
# Sends purchase thank-you + instructions, custom-website request
# confirmations, and admin notifications. If RESEND_API_KEY is unset,
# email is skipped (logged) and the app keeps working.
#   Get a key at resend.com and verify your sending domain.
RESEND_API_KEY=""
# The verified "from" address (must be on your verified domain).
RESEND_FROM_EMAIL="Magical Moments by Reign <info@magicalmomentsbyreign.com>"  # preferred; used only after domain verification
MAIL_FROM="Magical Moments by Reign <info@magicalmomentsbyreign.com>"  # backwards-compatible fallback
# Where admin notifications (new orders, new custom-website requests) go.
ADMIN_EMAIL="info@magicalmomentsbyreign.com"

# ── Admin area ─────────────────────────────────────────────────
# Password gate for /admin (custom website orders). Set to enable the
# admin area; leave blank to keep it disabled.
ADMIN_PASSWORD=""

# ── Custom website intake form (Jotform) ───────────────────────
# The intake form clients complete after a custom-website project is
# accepted. Optional: the admin can also paste a per-request link when
# accepting. Connect this Jotform to Google Sheets for a live
# spreadsheet that updates as orders come in (see docs/CUSTOM_WEBSITES.md).
CUSTOM_INTAKE_FORM_URL=""

# ── Custom domains + Legacy Protection ─────────────────────────
# Enables real domain search, registration, and automatic renewal for
# Diamond & Lifetime custom domains. When unset, the domain UI and
# Legacy Protection fallback still work; purchase/renewal show as
# pending instead of contacting a live registrar. See docs/DOMAINS.md.
REGISTRAR_PROVIDER=""       # e.g. "namecheap" | "godaddy"
REGISTRAR_API_KEY=""        # server-only secret
REGISTRAR_API_USER=""
REGISTRAR_API_BASE=""
# Automatic renewals charge a Square card-on-file (uses the Square keys
# above). Scheduled renewal reminders/retries run via a cron/worker that
# hits the renewal job — see docs/DOMAINS.md for the schedule.

# ── Magical Social Studio ──────────────────────────────────────
# Encryption key for social access tokens at rest (REQUIRED in prod).
# Generate with:  openssl rand -hex 32
SOCIAL_TOKEN_KEY=""

# Per-platform OAuth credentials. When a platform's CLIENT_ID and
# CLIENT_SECRET are both set, the studio switches that platform from
# sandbox mode to the real OAuth flow. Each also requires the app to
# meet the platform's eligibility + app-review requirements.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ── Spotify (member account connection, OAuth Authorization Code flow) ──
# From the Spotify Developer Dashboard (developer.spotify.com/dashboard) —
# app "Magical Moments By Reign". SPOTIFY_CLIENT_SECRET is server-only and
# is never sent to the browser. Redirect URI registered in that dashboard
# MUST exactly match:  {NEXT_PUBLIC_BASE_URL}/api/spotify/callback
#   e.g. https://magicalmomentsbyreign.com/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ── Magical Discovery ───────────────────────────────────────────
# Every category degrades to an honest "not connected" state (never sample
# or invented data) until its provider is configured. See
# src/lib/discovery/ and /dashboard/discovery/admin (Owner only).

# Today (news headlines). Get a key at newsapi.org.
NEWS_API_KEY=""

# Watch + Movies (TV/movie metadata, artwork, watch-provider availability).
# Get a key/read-token at themoviedb.org/settings/api.
TMDB_API_KEY=""

# Music (official charts + catalog search: artists/albums/tracks). Requires
# a MusicKit-enabled key from developer.apple.com — Certificates,
# Identifiers & Profiles → Keys. Completely separate from Spotify above —
# see src/lib/apple-music/ and src/lib/spotify/.
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_PRIVATE_KEY=""   # full contents of the downloaded .p8 file
APPLE_MUSIC_MEDIA_ID=""      # Media ID paired with the key above (Apple Developer → Identifiers → Media IDs). Not sent in the developer token or catalog requests today — only used if a future MusicKit JS (client-side, user-authorized) flow is added.

# Near You (events) + sporting-event tickets on the Sports tab.
# Get a key at developer.ticketmaster.com.
TICKETMASTER_API_KEY=""

# Sports (games, scores, standings) — NFL, College Football, NBA, MLB,
# Soccer, NHL, Rugby, Volleyball via API-Sports (api-sports.io, direct
# access, not the RapidAPI variant). One key covers every sport host. MMA
# and F1 aren't mapped by this provider (different, non-matchup formats);
# High School sports has no provider yet — see docs/DISCOVERY_SPORTS.md.
API_SPORTS_KEY=""
