{
  "name": "magical-by-reign",
  "version": "0.1.0",
  "private": true,
  "description": "The one master application powering unlimited unique customer experiences for Magical by Reign.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:netlify": "prisma generate && next build",
    "db:deploy": "RUN_DATABASE_PUSH=true node scripts/prepare-db.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "admin:bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "test": "node --import tsx --test \"src/lib/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:rls": "psql \"$DATABASE_URL\" -f supabase/migrations/20260804000000_enable_rls_public_schema.sql",
    "setup": "prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.49.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
