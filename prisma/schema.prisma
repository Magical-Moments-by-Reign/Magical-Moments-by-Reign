  scheduledAt     DateTime?
  status          String    @default("planned") // planned | scheduled | completed | canceled
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId])
}

// ── Family Command Center ───────────────────────────────────────
// Private family communication & organization. NOT a tracker, social platform,
