}

model FamilyReminder {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  forMemberId  String?
  type         String
  title        String
  dueAt        DateTime?
  status       String   @default("pending") // pending | completed
  confirmParent Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([familyId, status])
}

model FamilyTask {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title       String
  assigneeIds String   @default("[]") // JSON of member ids (one or many)
  status      String   @default("open") // open | in_progress | done
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  @@index([familyId, status])
}

model FamilyCalendarEvent {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title      String
  category   String
  startAt    DateTime
  endAt      DateTime?
  visibility String   @default("family") // family | adults | custom
  createdAt  DateTime @default(now())

  @@index([familyId, startAt])
}

model FamilyAchievement {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId  String?
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([familyId])
}

// ── Family Connections ──────────────────────────────────────────
// One membership → the whole family participates. The Host invites guests to a
// specific Magical Moment (Experience); guests need no paid membership. Guests
// access ONLY the moments they're invited to. NOT a social platform; the Family
// Map is general-location + opt-in (never live tracking). Video providers,
// storage, and delivery are seams. Logic in src/lib/family-connections.ts.
model FamilyGuest {
  id             String   @id @default(cuid())
  experienceId   String   // the Magical Moment they're invited to
  hostAccountId  String?
  name           String
  contactMasked  String? // masked email/phone for display
  permissions    String   @default("{}") // JSON GuestPermissionSet
  status         String   @default("invited") // invited | joined | declined
  invitedMoments String   @default("[]") // JSON experience ids this guest may access
  createdAt      DateTime @default(now())

  @@index([experienceId, status])
}

model FamilyTimelineEntry {
  id        String   @id @default(cuid())
  familyId  String
  type      String   // Birthdays | Weddings | New Babies | Military Deployments | ...
  title     String
  date      DateTime?
  memberId  String?
  createdAt DateTime @default(now())

  @@index([familyId, date])
}

model FamilyFeedPost {
  id           String   @id @default(cuid())
  experienceId String
  authorName   String
  kind         String   // achievement | message | photo | video | milestone | welcome | support
  body         String?
  mediaUrl     String? // secure storage ref
  createdAt    DateTime @default(now())

  @@index([experienceId])
}

model FamilyGathering {
  id           String    @id @default(cuid())
  experienceId String
  title        String
  type         String    // Family Reunions | Holiday Gatherings | Memorial Celebrations | ...
  scheduledAt  DateTime?
  provider     String? // trusted video provider (seam) or "native"
  joinUrl      String?
  createdAt    DateTime  @default(now())

  @@index([experienceId])
}

// General location only (city/region), opt-in — NEVER live location tracking.
model FamilyMapLocation {
  id              String   @id @default(cuid())
  familyId        String
  memberName      String
  generalLocation String   // e.g. "Birmingham, Alabama" — city/region only
  shared          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([familyId])
}

// ── Family Birthday & Celebration Network ───────────────────────
// A living family celebration calendar that repeats yearly automatically.
// Non-members can be added manually and linked later without losing history.
// Only shared/visible entries appear. Logic in src/lib/celebration-network.ts.
model CelebrationEntry {
  id           String   @id @default(cuid())
  familyId     String
  type         String   @default("birthday") // birthday | anniversary | graduation | memorial | ...
  personName   String
  month        Int      // 1–12
  day          Int      // 1–31
  year         Int?     // original year (optional; enables age/years)
  relationship String?
  photoUrl     String?
  memberId     String?  // linked connected member, when applicable
  source       String   @default("manual") // member | manual
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([familyId, month])
}

model CelebrationReminderPref {
  id         String   @id @default(cuid())
  familyId   String
  memberId   String?  // whose preferences these are
  group      String   @default("entire") // immediate | entire | grandchildren | friends | custom
  offsetsDays String  @default("[14,7,2,0]") // JSON reminder offsets
  include30  Boolean  @default(false)
  leapMode   String   @default("feb_28") // feb_28 | mar_1
  channels   String   @default("{}") // JSON notify prefs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([familyId])
}

// ── Platform foundation: sessions, notifications, invitations ───
// Shared auth/notification/invitation infrastructure activating all completed
// ecosystems. Logic in src/lib/auth.ts, notifications.ts, invitations.ts, roles.ts.
model Session {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique // sha256 of the opaque session token
  userAgentHash String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([accountId])
}

// ── Personal Concierge ─────────────────────────────────────────
// Every account has its OWN concierge — a named companion, not a shared
// household assistant. Each family member (child, teen, parent, grandparent,
// invited relative) is a separate Account, so each person names and grows their
// own concierge. "Magical" is always the platform/technology; the concierge's
// NAME belongs to the customer ("Powered by Magical, and its name is Journey").
//
// First-run signal: no row → the person hasn't met their concierge yet (show
// the welcome). A row with welcomedAt set but name null → they met it and
// skipped naming for now (call it "Magical", offer gentle, no-pressure
// reminders). A row with a name → use the name everywhere.
//
// Built to grow: persona/voice and a JSON preferences bag (favorite colors,
// family members, anniversaries, communication style…) are here for the
// concierge to become smarter and more personal the longer someone stays.
model Concierge {
  id          String    @id @default(cuid())
  accountId   String    @unique
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String?   // customer-chosen name; null = not yet named (may have skipped)
  welcomedAt  DateTime? // set once the person has seen the welcome/introduction
  persona     String?   // future: personality preset (warm, elegant, coach…)
  voice       String?   // future: voice / accent selection
  preferences String    @default("{}") // JSON growth bag (colors, family, dates…)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// An in-app notification (source of truth) + record of external delivery.
model Notification {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type            String   // NotificationType (see notifications.ts)
  title           String
  body            String
  data            String   @default("{}") // JSON payload / deep-link
  channelsPlanned String   @default("[]") // JSON channels attempted
  channelsQueued  String   @default("[]") // JSON channels awaiting a provider
  readAt          DateTime?
  archivedAt      DateTime? // moved out of the active inbox (never deleted)
  actionUrl       String?   // deep-link the "View" action opens
  relatedLabel    String?   // e.g. related member / Moment name (for display)
  createdAt       DateTime @default(now())

  @@index([accountId, readAt])
  @@index([accountId, archivedAt])
  @@index([type])
}

// Per-account, per-type channel preferences (defaults come from the type).
model NotificationPreference {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String   // NotificationType
  channels  String   @default("{}") // JSON ChannelPrefs { in_app, email, sms, push }
  updatedAt DateTime @updatedAt

  @@unique([accountId, type])
}

// A secure, hashed-token invitation (family member / guest / vendor / collaborator).
model Invitation {
  id               String   @id @default(cuid())
  kind             String   // family_member | guest | vendor | collaborator
  role             String   // PlatformRole assigned on acceptance
  tokenHash        String   @unique
  inviterAccountId String?
  inviter          Account? @relation("inviter", fields: [inviterAccountId], references: [id], onDelete: SetNull)
  targetNormalized String   // canonical email / digit phone (matching only)
  targetMasked     String   // shown on the invite screen
  familyId         String?
  experienceId     String?
  vendorId         String?
  guardianRequired Boolean  @default(false)
  status           String   @default("pending") // pending | accepted | revoked | expired
  acceptedByAccountId String?
  acceptedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([status])
  @@index([targetNormalized])
}

// A single-use, HASHED token for email verification and password reset.
// The URL carries only the opaque token; we store sha256(token). Tokens are
// single-use (usedAt) and expiring. See src/lib/auth-support.ts.
model AuthToken {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String    // verify_email | password_reset
  tokenHash String    @unique // sha256 of the opaque token — never the token itself
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, purpose])
}

// A parent/guardian approval record for a minor account. The minor cannot use
// the platform until a guardian approves. The approval link is a HASHED token
// sent to the guardian's contact; the guardian sets the minor's permissions.
// NO location tracking or hidden monitoring is ever recorded here.
model GuardianApproval {
  id                      String    @id @default(cuid())
  minorAccountId          String
  minor                   Account   @relation(fields: [minorAccountId], references: [id], onDelete: Cascade)
  guardianAccountId       String?   // set once the guardian is identified/linked
  guardianEmailNormalized String    @default("") // canonical email (matching only)
  guardianEmailMasked     String    @default("") // shown for display
  tokenHash               String    @unique
  status                  String    @default("pending") // pending | approved | declined | expired
  permissions             String    @default("{}") // JSON PermissionSet the guardian granted
  decidedAt               DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())

  @@index([minorAccountId])
  @@index([status])
}

// A durable, shared login/abuse rate-limit hit. One row per attempt within a
// window; a bucket is a SHA-256 hash of (action + IP + hashed email + accountId)
// — NEVER a raw email. Shared across serverless instances via PostgreSQL.
// Expired rows are cleaned opportunistically (expiresAt). See src/lib/rate-limit.ts.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String   // sha256 bucket key — no raw PII
  action    String   // RateAction (login | password_reset | verify_resend | ...)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([bucket, createdAt])
  @@index([expiresAt])
}
