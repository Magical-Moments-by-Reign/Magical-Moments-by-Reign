  body         String
  officialLinks String     @default("[]") // JSON [{ label, url }] to official sources
  status       GuideStatus @default(PUBLISHED)
  featured     Boolean     @default(false)
  createdBy    String      @default("Founder")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([center, status])
  @@index([stateCode])
  @@index([grade])
