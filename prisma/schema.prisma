// ── Family Financial Foundation ─────────────────────────────────
// Per-family financial-milestone progress + bank-appointment link-outs.
// Educational only. Family savings goals reuse the generic SavingsGoal model.
model FinancialMilestoneProgress {
  id          String   @id @default(cuid())
  accountId   String?
  milestoneId String   // see FINANCIAL_MILESTONES in src/lib/family-finance.ts
  status      String   @default("not_started") // not_started | in_progress | completed
