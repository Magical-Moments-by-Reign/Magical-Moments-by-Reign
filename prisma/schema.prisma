  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  senderId     String
  recipientIds String   @default("[]") // JSON of member ids
  body         String
  dueDate      DateTime?
  remindAt     DateTime?
  priority     String   @default("normal") // low | normal | high
  completed    Boolean  @default(false)
