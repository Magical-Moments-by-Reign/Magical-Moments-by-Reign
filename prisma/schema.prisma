model SavingsContribution {
  id              String      @id @default(cuid())
  goalId          String
  goal            SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contributorName String
  amountCents     Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([goalId])
