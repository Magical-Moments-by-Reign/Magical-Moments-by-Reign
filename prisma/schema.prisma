  accountId  String?
  name       String
  status     String   @default("applied") // applied | awarded | pending | declined
  amountCents Int     @default(0)
  deadline   DateTime?
  essayUrl   String? // secure storage ref
  recLetterUrl String?
  createdAt  DateTime @default(now())
